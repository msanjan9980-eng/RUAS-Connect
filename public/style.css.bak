* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Plus Jakarta Sans', sans-serif;
}

body {
    background-color: #07070c;
    color: #f8fafc;
    height: 100vh;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.hidden { display: none !important; }

.bg-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    z-index: 0;
    opacity: 0.45;
}
.orb-1 { width: 420px; height: 420px; background: #4f46e5; top: -100px; left: -100px; }
.orb-2 { width: 380px; height: 380px; background: #06b6d4; bottom: -100px; right: -80px; }

.center-container {
    z-index: 2;
    width: 100%;
    max-width: 460px;
    padding: 20px;
}

.glass-panel {
    background: rgba(17, 17, 27, 0.82);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 40px 32px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75);
}

.campus-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #a5b4fc;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 6px 14px;
    border-radius: 99px;
    margin-bottom: 18px;
}

.pulse-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
}

h1 {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 10px;
    background: linear-gradient(to right, #ffffff, #a5b4fc);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.subtitle {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 24px;
}

.input-group {
    text-align: left;
    margin-bottom: 14px;
}

.input-group label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 6px;
}

input {
    width: 100%;
    padding: 13px 16px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(9, 9, 15, 0.85);
    color: #fff;
    font-size: 0.95rem;
    outline: none;
    transition: border 0.2s;
}

input:focus { border-color: #6366f1; }

.mode-selector {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 16px 0;
}

.mode-btn {
    padding: 11px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: #94a3b8;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.mode-btn.active {
    background: rgba(99, 102, 241, 0.22);
    border-color: #6366f1;
    color: #fff;
}

.glow-btn {
    width: 100%;
    padding: 14px;
    border-radius: 12px;
    border: none;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #fff;
    font-weight: 700;
    font-size: 0.98rem;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(99, 102, 241, 0.35);
    transition: transform 0.15s;
}

.glow-btn:hover { transform: translateY(-2px); }

.link-btn {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 0.8rem;
    margin-top: 12px;
    cursor: pointer;
    display: inline-block;
}
.link-btn:hover { color: #fff; }

.status-msg {
    font-size: 0.83rem;
    margin-top: 14px;
    min-height: 18px;
    color: #38bdf8;
}
.status-msg.error { color: #f87171; }

.footer-note {
    margin-top: 14px;
    font-size: 0.75rem;
    color: #64748b;
}

/* Main App Layout */
.app-layout {
    z-index: 2;
    width: 96vw;
    max-width: 1320px;
    height: 92vh;
    background: rgba(15, 15, 24, 0.88);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.8);
}

.topbar {
    padding: 14px 24px;
    background: rgba(7, 7, 12, 0.65);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo-area { display: flex; align-items: center; gap: 10px; }
.logo-area h2 { font-size: 1.25rem; font-weight: 800; }
.logo-area span { color: #818cf8; }

.header-right { display: flex; align-items: center; gap: 10px; }

.tag, .user-chip {
    font-size: 0.78rem;
    padding: 6px 12px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.07);
    color: #e2e8f0;
}

.report-btn {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
    padding: 6px 14px;
    border-radius: 99px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
}

.logout-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    padding: 6px 14px;
    border-radius: 99px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
}
.logout-btn:hover { background: rgba(255, 255, 255, 0.2); }

/* Workspace Split */
.workspace { flex: 1; display: flex; overflow: hidden; }

.video-panel {
    width: 45%;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.25);
}

.video-card {
    flex: 1;
    background: #09090f;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }

.video-status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(9, 9, 15, 0.78);
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 600;
}

.cam-label {
    position: absolute;
    bottom: 10px;
    left: 12px;
    background: rgba(0, 0, 0, 0.65);
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
}

.chat-panel { flex: 1; display: flex; flex-direction: column; }

.messages-area {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.sys-msg {
    align-self: center;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.25);
    color: #c7d2fe;
    font-size: 0.82rem;
    padding: 7px 14px;
    border-radius: 99px;
    text-align: center;
}

.msg {
    max-width: 75%;
    padding: 11px 16px;
    border-radius: 16px;
    font-size: 0.92rem;
    line-height: 1.4;
    word-wrap: break-word;
}

.msg.you {
    align-self: flex-end;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: #fff;
    border-bottom-right-radius: 4px;
}

.msg.stranger {
    align-self: flex-start;
    background: #1e1e2e;
    color: #f1f5f9;
    border-bottom-left-radius: 4px;
}

.typing-bar { padding: 4px 20px; font-size: 0.78rem; color: #818cf8; font-style: italic; }

.controls-bar {
    padding: 14px 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    gap: 10px;
    background: rgba(7, 7, 12, 0.5);
}

.ctrl-btn {
    min-width: 105px;
    border-radius: 12px;
    border: none;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
}
.ctrl-btn.start { background: #10b981; }
.ctrl-btn.stop { background: #ef4444; }
.ctrl-btn.confirm { background: #f97316; }

.send-btn {
    padding: 0 22px;
    border-radius: 12px;
    border: none;
    background: #6366f1;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
}
.send-btn:disabled, input:disabled { opacity: 0.45; cursor: not-allowed; }

/* Admin Analytics Dashboard */
.admin-content { padding: 28px; overflow-y: auto; flex: 1; }

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 14px;
    margin-bottom: 26px;
}

.stat-box {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 18px 20px;
    border-radius: 16px;
}
.stat-box h3 { font-size: 1.9rem; color: #38bdf8; margin-bottom: 4px; }
.stat-box.danger h3 { color: #f87171; }
.stat-box p { font-size: 0.8rem; color: #94a3b8; font-weight: 600; }

.admin-section { margin-bottom: 26px; }
.section-title { margin-bottom: 12px; font-size: 1rem; color: #e2e8f0; }

.branch-pills { display: flex; flex-wrap: wrap; gap: 10px; }

.reports-container { display: flex; flex-direction: column; gap: 12px; }
.report-card {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
    padding: 16px 20px;
    border-radius: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}
.report-info p { font-size: 0.85rem; margin-bottom: 4px; }
.report-actions { display: flex; gap: 8px; }
.ban-btn { background: #dc2626; color: white; border: none; padding: 8px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; }
.dismiss-btn { background: #334155; color: white; border: none; padding: 8px 14px; border-radius: 8px; cursor: pointer; }
.unban-btn { background: #10b981; color: #052e16; border: none; padding: 5px 12px; border-radius: 99px; font-weight: 700; font-size: 0.78rem; cursor: pointer; }
.empty-state { color: #64748b; font-size: 0.88rem; }

@media (max-width: 768px) {
    .workspace { flex-direction: column; }
    .video-panel { width: 100%; height: 42%; flex-direction: row; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); }
}